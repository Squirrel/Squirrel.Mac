config("ohhttpstubs_config") {
  include_dirs = [ "../vendor/OHHTTPStubs" ]
}

source_set("ohhttpstubs") {
  testonly = true
  public_configs = [ ":ohhttpstubs_config" ]
  sources = [
    "../vendor/OHHTTPStubs/OHHTTPStubs/OHHTTPStubs.h",
    "../vendor/OHHTTPStubs/OHHTTPStubs/OHHTTPStubs.m",
    "../vendor/OHHTTPStubs/OHHTTPStubs/OHHTTPStubsResponse.h",
    "../vendor/OHHTTPStubs/OHHTTPStubs/OHHTTPStubsResponse.m",
  ]
  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ ":vendor_code" ]
  frameworks = [ "Foundation.framework" ]
}

# The generator half of Sparkle's BinaryDelta, so the specs can produce deltas
# for Squirrel.framework's applier to consume. Its headers, which the specs
# include too, expect the configuration //:sparkle_binary_delta is built with.
config("sparkle_binary_delta_config") {
  include_dirs = [
    "../vendor/Sparkle/Autoupdate",
    "../vendor/Sparkle/Sparkle",
    "../vendor/Sparkle/Vendor/bsdiff",
  ]
  cflags = [
    "-include",
    rebase_path("../Squirrel/SparkleDelta/SparkleDeltaConfig.h",
                root_build_dir),
  ]
}

source_set("sparkle_binary_delta_create") {
  testonly = true
  sources = [
    "../vendor/Sparkle/Autoupdate/SUBinaryDeltaCreate.h",
    "../vendor/Sparkle/Autoupdate/SUBinaryDeltaCreate.m",
    "../vendor/Sparkle/Vendor/bsdiff/bsdiff.c",
    "../vendor/Sparkle/Vendor/bsdiff/sais.c",
    "../vendor/Sparkle/Vendor/bsdiff/sais.h",
  ]
  public_configs = [ ":sparkle_binary_delta_config" ]
  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]
  cflags = [ "-w" ]
  cflags_objc = [ "-fobjc-arc" ]
  frameworks = [ "Foundation.framework" ]
}

_fixtures_dir = "$root_out_dir/fixtures"

# script/sign-test-fixtures derives the signed TestApplication fixtures the
# install and code-signature specs use from the built TestApplication.app.
action("fixtures") {
  testonly = true
  script = "//gn/run.py"
  deps = [ "//TestApplication:test_application" ]
  inputs = [ "../script/sign-test-fixtures" ]
  outputs = [
    "$_fixtures_dir/TestApplication 2.1.app",
    "$_fixtures_dir/TestApplication.app",
    "$_fixtures_dir/TestApplication.app.zip",
  ]
  args = [
    rebase_path("../script/sign-test-fixtures", root_build_dir),
    rebase_path("$root_out_dir/TestApplication.app", root_build_dir),
    rebase_path(_fixtures_dir, root_build_dir),
  ]
}

bundle_data("squirrel_tests_resources") {
  testonly = true
  sources = get_target_outputs(":fixtures") + [ "TestServer.py" ]
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  public_deps = [ ":fixtures" ]
}

bundle_data("squirrel_tests_frameworks") {
  testonly = true
  sources = [
    "$root_out_dir/Mantle.framework",
    "$root_out_dir/Nimble.framework",
    "$root_out_dir/Quick.framework",
    "$root_out_dir/ReactiveObjC.framework",
    "$root_out_dir/Squirrel.framework",
  ]
  outputs = [ "{{bundle_contents_dir}}/Frameworks/{{source_file_part}}" ]
  public_deps = [
    ":nimble_framework",
    ":quick_framework",
    "//:mantle_framework",
    "//:reactiveobjc_framework",
    "//:squirrel_framework",
  ]
}

mac_info_plist("squirrel_tests_info_plist") {
  testonly = true
  executable_name = "SquirrelTests"
  info_plist = "SquirrelTests-Info.plist"
  extra_substitutions = [ "PRODUCT_BUNDLE_IDENTIFIER=com.github.SquirrelTests" ]
}

bundle_data("squirrel_tests_info_plist_bundle_data") {
  testonly = true
  sources = get_target_outputs(":squirrel_tests_info_plist")
  outputs = [ "{{bundle_contents_dir}}/Info.plist" ]
  public_deps = [ ":squirrel_tests_info_plist" ]
}

loadable_module("squirrel_tests_module") {
  testonly = true
  output_name = "SquirrelTests"
  output_dir = target_out_dir
  output_extension = ""
  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    ":xctest_config",
  ]
  sources = [
    "../Squirrel/SQRLInstaller.m",
    "../Squirrel/SQRLInstallerOwnedBundle.m",
    "../Squirrel/SQRLTerminationListener.m",
    "../TestApplication/TestAppConstants.m",
    "NSProcessInfoExtensionsSpec.m",
    "QuickSpec+SQRLFixtures.h",
    "QuickSpec+SQRLFixtures.m",
    "SQRLCodeSignatureSpec.m",
    "SQRLDirectoryManagerSpec.m",
    "SQRLDownloaderSpec.m",
    "SQRLInstallerSpec.m",
    "SQRLShipItRequestSpec.m",
    "SQRLTerminationListenerSpec.m",
    "SQRLTestUpdate.h",
    "SQRLTestUpdate.m",
    "SQRLUpdateSpec.m",
    "SQRLUpdaterSpec.m",
    "SQRLZipArchiverSpec.m",
  ]
  include_dirs = [
    "../Squirrel",
    "../TestApplication",
    "../vendor/ReactiveObjC/ReactiveObjC/extobjc",
  ]
  deps = [
    ":nimble_framework+link",
    ":ohhttpstubs",
    ":quick_framework+link",
    ":sparkle_binary_delta_create",
    "//:mantle_framework+link",
    "//:reactiveobjc_framework+link",
    "//:squirrel_framework+link",
  ]
  frameworks = [
    "AppKit.framework",
    "Foundation.framework",
    "IOKit.framework",
    "Security.framework",
    "ServiceManagement.framework",
  ]
  cflags_objc = [
    "-fobjc-arc",
    "-Wno-deprecated-declarations",

    # The specs use the Swift-implemented parts of Quick and Nimble's API,
    # which their umbrella headers only expose through Clang modules.
    "-include",
    rebase_path("SquirrelTests-Prefix.h", root_build_dir),
  ]
  ldflags = [ "-Wl,-rpath,@loader_path/../Frameworks" ]
}

bundle_data("squirrel_tests_module_bundle_data") {
  testonly = true
  sources = [ "$target_out_dir/SquirrelTests" ]
  outputs = [ "{{bundle_executable_dir}}/SquirrelTests" ]
  public_deps = [ ":squirrel_tests_module" ]
}

create_bundle("squirrel_tests") {
  testonly = true
  product_type = "com.apple.product-type.bundle.unit-test"
  bundle_root_dir = "$root_out_dir/SquirrelTests.xctest"
  bundle_contents_dir = "$bundle_root_dir/Contents"
  bundle_resources_dir = "$bundle_contents_dir/Resources"
  bundle_executable_dir = "$bundle_contents_dir/MacOS"
  deps = [
    ":squirrel_tests_frameworks",
    ":squirrel_tests_info_plist_bundle_data",
    ":squirrel_tests_module_bundle_data",
    ":squirrel_tests_resources",
  ]
}
