import("//build/config/mac/mac_sdk.gni")
import("//build/config/mac/rules.gni")
import("//gn/swift_module.gni")

# XCTest and the Swift XCTest support libraries ship with the platform, not
# the SDK. //build symlinks the platform and toolchain next to the SDK it hands
# to the compiler, so derive their paths from that.
_xcode_links = get_path_info(mac_sdk_path, "dir")
_platform_developer_dir = "$_xcode_links/MacOSX.platform/Developer"
xctest_framework_dir = "$_platform_developer_dir/Library/Frameworks"
xctest_lib_dir = "$_platform_developer_dir/usr/lib"
swift_lib_dirs = [
  "$mac_sdk_path/usr/lib/swift",
  "$_xcode_links/XcodeDefault.xctoolchain/usr/lib/swift/macosx",
  xctest_lib_dir,
]
xctest_swiftflags = [
  "-F" + rebase_path(xctest_framework_dir, root_build_dir),
  "-I" + rebase_path(xctest_lib_dir, root_build_dir),
]

# XCTest is built for a newer macOS than Squirrel targets (14.0 as of Xcode
# 26) and lld rejects linking against a library newer than the image's own
# deployment target, so the images that link XCTest raise theirs.
config("xctest_config") {
  framework_dirs = [ xctest_framework_dir ]
  frameworks = [ "XCTest.framework" ]
  ldflags = [ "-mmacos-version-min=14.0" ]
}

config("vendor_code") {
  configs = [ "//build/config/compiler:no_chromium_code" ]
  cflags_objc = [ "-fobjc-arc" ]
}

# Quick and Nimble are mixed Swift/Objective-C frameworks. The Swift half is
# compiled against a module map over the staged public headers
# (-import-underlying-module), the Objective-C half against the generated
# <Module>-Swift.h, and both are linked into one framework.
template("mixed_framework") {
  _target_name = target_name
  _module = invoker.module_name
  _staged_dir = "$target_gen_dir/$_module/include"
  _module_map = "$_staged_dir/$_module/module.modulemap"

  write_file(_module_map,
             [
               "module $_module {",
               "  umbrella header \"$_module.h\"",
               "  export *",
               "  module * { export * }",
               "}",
             ])

  copy("${_target_name}_staged_headers") {
    testonly = true
    sources = invoker.public_headers
    outputs = [ "$_staged_dir/$_module/{{source_file_part}}" ]
  }

  swift_module("${_target_name}_swift") {
    testonly = true
    module_name = _module
    header_dir = "$_staged_dir/$_module"
    sources = invoker.swift_sources
    inputs = [ _module_map ] + invoker.public_headers
    deps = [ ":${_target_name}_staged_headers" ]
    swiftflags =
        [
          # As in their Xcode projects; this is also what makes swiftc emit
          # internal @objc classes (World, CurrentTestCaseTracker, ...) into
          # the generated header the Objective-C half compiles against.
          "-application-extension",
          "-import-underlying-module",
          "-Xcc",
          "-fmodule-map-file=" + rebase_path(_module_map, root_build_dir),
          "-Xcc",
          "-I" + rebase_path(_staged_dir, root_build_dir),
          "-suppress-warnings",
        ] + xctest_swiftflags
  }

  bundle_data("${_target_name}_headers") {
    testonly = true
    sources =
        invoker.public_headers + [ "$_staged_dir/$_module/$_module-Swift.h" ]
    outputs = [ "{{bundle_contents_dir}}/Headers/{{source_file_part}}" ]
    public_deps = [ ":${_target_name}_swift" ]
  }

  mac_framework_bundle(_target_name) {
    testonly = true
    output_name = _module
    framework_version = "A"
    framework_contents = [
      "Headers",
      "Resources",
    ]
    info_plist = invoker.info_plist
    extra_substitutions = [
      "CURRENT_PROJECT_VERSION=0.0.0",
      "PRODUCT_BUNDLE_IDENTIFIER=${invoker.bundle_identifier}",
    ]
    configs -= [
      "//build/config/compiler:chromium_code",
      "//build/config/gcc:symbol_visibility_hidden",
    ]
    configs += [
      ":vendor_code",
      ":xctest_config",
    ]
    sources = invoker.sources + [ "$target_out_dir/$_module.o" ]
    include_dirs = [
      _staged_dir,
      "$_staged_dir/$_module",
    ]
    lib_dirs = swift_lib_dirs
    ldflags = [
      "-Wl,-install_name,@rpath/$_module.framework/$_module",
      "-Wl,-rpath,/usr/lib/swift",
    ]
    if (defined(invoker.ldflags)) {
      ldflags += invoker.ldflags
    }
    deps = [
      ":${_target_name}_headers",
      ":${_target_name}_swift",
    ]
  }
}

