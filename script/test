#!/bin/bash
#
# Runs SquirrelTests.xctest from a GN build directory under Xcode's xctest.
#
# usage: script/test [out/Default]

set -eo pipefail

cd "$(dirname "$0")/.."
OUT="${1:-out/Default}"

# Quick and Nimble link XCTest and its Swift support library, which live in
# the platform's Developer directory rather than the SDK.
PLATFORM_DEVELOPER_DIR="$(xcrun --show-sdk-platform-path)/Developer"
export DYLD_FRAMEWORK_PATH="${PLATFORM_DEVELOPER_DIR}/Library/Frameworks"
export DYLD_LIBRARY_PATH="${PLATFORM_DEVELOPER_DIR}/usr/lib"

# The xctest host has no bundle identifier of its own for SQRLDirectoryManager.
export FORCE_APP_IDENTIFIER=com.github.Squirrel.SquirrelTests
export SQUIRREL_TEST_LOCAL_SERVER=True
export SQUIRREL_TEST_LOCAL_CDN=True

exec "$(xcrun --find xctest)" -XCTest All "${OUT}/SquirrelTests.xctest"
