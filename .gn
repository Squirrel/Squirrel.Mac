import("//build/dotfile_settings.gni")

buildconfig = "//build/config/BUILDCONFIG.gn"
script_executable = "python3"

default_args = {
  # Squirrel is Objective-C only; link the SDK's libc++ rather than building
  # Chromium's, and skip Chromium's clang plugins and style checks.
  use_custom_libcxx = false
  use_custom_libcxx_for_host = false
  use_llvm_libatomic = false
  clang_use_chrome_plugins = false
  treat_warnings_as_errors = false

  # The oldest macOS the frameworks load on.
  mac_deployment_target = "11.0"
  mac_min_system_version = "11.0"

  # The SDK in the oldest Xcode CI runs with.
  mac_sdk_min = "14"
}

exec_script_allowlist = build_dotfile_settings.exec_script_allowlist
expand_directory_allowlist = build_dotfile_settings.expand_directory_allowlist
